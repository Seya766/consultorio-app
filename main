import React, { useState } from 'react';
import { 
  Scale, 
  LayoutDashboard, 
  FolderOpen, 
  CalendarDays, 
  LogOut, 
  Plus, 
  Bell, 
  Clock, 
  FileText,
  BookOpen,
  GraduationCap
} from 'lucide-react';

// --- TEMA Y ESTILOS (Serio pero Académico) ---
const THEME = {
  bg: 'bg-[#F9F8F4]', // Color Papel Hueso/Crema
  sidebar: 'bg-[#1C1C1E]', // Negro suave
  accent: 'bg-[#003366]', // Azul Universitario Oscuro (Más académico)
  accentHover: 'hover:bg-[#002244]',
  textMain: 'text-[#1C1C1E]',
  textMuted: 'text-[#6e6e73]',
  border: 'border-[#E5E5E0]',
};

// --- COMPONENTES UI ---

const Card = ({ children, className = "" }) => (
  <div className={`bg-white border border-[#E5E5E0] shadow-sm rounded-lg p-6 ${className}`}>
    {children}
  </div>
);

const Button = ({ children, onClick, variant = 'primary', className = "" }) => {
  const styles = {
    primary: `${THEME.accent} text-white hover:shadow-md border border-transparent`,
    secondary: 'bg-white text-[#1C1C1E] border border-[#D1D1CB] hover:bg-[#F2F2F0] hover:border-[#003366]',
    ghost: 'bg-transparent text-[#6e6e73] hover:text-[#1C1C1E] hover:bg-[#E5E5E0]',
  };

  return (
    <button 
      onClick={onClick}
      className={`px-5 py-2.5 rounded-md font-medium text-sm transition-all duration-200 active:scale-95 flex items-center justify-center gap-2 ${styles[variant]} ${className}`}
    >
      {children}
    </button>
  );
};

const Badge = ({ children, type }) => {
  const colors = {
    active: 'bg-[#E8F5E9] text-[#1B5E20] border-[#C8E6C9]', 
    pending: 'bg-[#FFF8E1] text-[#F57F17] border-[#FFE082]',
    urgent: 'bg-[#FFEBEE] text-[#B71C1C] border-[#FFCDD2]' 
  };
  return (
    <span className={`px-2 py-0.5 rounded text-[11px] font-bold uppercase tracking-wider border ${colors[type] || colors.active}`}>
      {children}
    </span>
  );
};

// --- PANTALLA DE REGISTRO / LOGIN ---

const AuthScreen = ({ onLogin }) => {
  const [isRegistering, setIsRegistering] = useState(true);
  const [formData, setFormData] = useState({ name: '', code: '', semester: '', clinic: '' });

  const handleSubmit = (e) => {
    e.preventDefault();
    if (isRegistering && (!formData.name || !formData.semester || !formData.clinic)) {
      alert("Por favor completa tu perfil de estudiante.");
      return;
    }
    // Si es login, simulamos que toma el nombre del registro previo o uno genérico
    onLogin({
      name: formData.name || "Estudiante",
      semester: formData.semester || "7",
      clinic: formData.clinic || "I"
    });
  };

  return (
    <div className="min-h-screen bg-[#F9F8F4] flex items-center justify-center p-6 font-sans">
      <div className="w-full max-w-4xl bg-white shadow-xl rounded-xl overflow-hidden flex flex-col md:flex-row border border-[#D1D1CB]">
        
        {/* Panel Izquierdo */}
        <div className="md:w-2/5 bg-[#1C1C1E] p-10 flex flex-col justify-between text-white relative">
          <div className="relative z-10">
            <div className="flex items-center gap-3 mb-6">
              <Scale className="w-8 h-8 text-white" /> 
              <h1 className="text-2xl font-bold tracking-tight">Consultorio App</h1>
            </div>
            <p className="text-[#A1A1AA] text-sm leading-relaxed">
              Gestión académica y seguimiento de casos para estudiantes de derecho.
            </p>
          </div>
          <div className="relative z-10 text-xs text-[#52525B]">
            Portal del Estudiante
          </div>
        </div>

        {/* Panel Derecho */}
        <div className="md:w-3/5 p-10 md:p-14">
          <h2 className="text-2xl font-bold text-[#1C1C1E] mb-2">
            {isRegistering ? 'Registro de Estudiante' : 'Iniciar Sesión'}
          </h2>
          <p className="text-[#6e6e73] text-sm mb-8">
            {isRegistering ? 'Configura tus datos del semestre actual.' : 'Ingresa con tu código estudiantil.'}
          </p>

          <form onSubmit={handleSubmit} className="space-y-5">
            {isRegistering && (
              <div className="space-y-1">
                <label className="text-xs font-bold text-[#1C1C1E] uppercase tracking-wide">Nombre Completo</label>
                <input 
                  required
                  type="text" 
                  placeholder="Ej. Camila Torres"
                  className="w-full px-4 py-3 bg-[#F9F8F4] border border-[#D1D1CB] rounded focus:outline-none focus:border-[#003366] transition-all"
                  value={formData.name}
                  onChange={e => setFormData({...formData, name: e.target.value})}
                />
              </div>
            )}

            <div className="space-y-1">
               <label className="text-xs font-bold text-[#1C1C1E] uppercase tracking-wide">Código Estudiantil / Usuario</label>
               <input 
                required
                className="w-full px-4 py-3 bg-[#F9F8F4] border border-[#D1D1CB] rounded focus:outline-none focus:border-[#003366]" 
                type="text" 
                value={formData.code}
                onChange={e => setFormData({...formData, code: e.target.value})}
               />
            </div>
            
            {!isRegistering && (
              <div className="space-y-1">
                 <label className="text-xs font-bold text-[#1C1C1E] uppercase tracking-wide">Contraseña</label>
                 <input className="w-full px-4 py-3 bg-[#F9F8F4] border border-[#D1D1CB] rounded focus:outline-none focus:border-[#003366]" type="password" />
              </div>
            )}

            {isRegistering && (
              <div className="grid grid-cols-2 gap-4">
                <div className="space-y-1">
                  <label className="text-xs font-bold text-[#1C1C1E] uppercase tracking-wide">Semestre</label>
                  <select 
                    required
                    className="w-full px-3 py-3 bg-[#F9F8F4] border border-[#D1D1CB] rounded focus:outline-none focus:border-[#003366]"
                    value={formData.semester}
                    onChange={e => setFormData({...formData, semester: e.target.value})}
                  >
                    <option value="" disabled>Seleccionar...</option>
                    {[...Array(10)].map((_, i) => <option key={i+1} value={i+1}>{i+1}º Semestre</option>)}
                  </select>
                </div>
                <div className="space-y-1">
                  <label className="text-xs font-bold text-[#1C1C1E] uppercase tracking-wide">Consultorio</label>
                  <select 
                    required
                    className="w-full px-3 py-3 bg-[#F9F8F4] border border-[#D1D1CB] rounded focus:outline-none focus:border-[#003366]"
                    value={formData.clinic}
                    onChange={e => setFormData({...formData, clinic: e.target.value})}
                  >
                    <option value="" disabled>Seleccionar...</option>
                    <option value="I">I - Civil/Familia</option>
                    <option value="II">II - Penal</option>
                    <option value="III">III - Público</option>
                    <option value="IV">IV - Laboral</option>
                  </select>
                </div>
              </div>
            )}

            <div className="pt-4">
              <button 
                type="submit"
                className="w-full py-3 bg-[#003366] hover:bg-[#002244] text-white font-medium rounded shadow-sm transition-all"
              >
                {isRegistering ? 'Comenzar Semestre' : 'Ingresar'}
              </button>
            </div>
          </form>

          <div className="mt-6 text-center border-t border-[#E5E5E0] pt-6">
            <button 
              onClick={() => setIsRegistering(!isRegistering)}
              className="text-sm text-[#003366] hover:underline font-medium"
            >
              {isRegistering ? '¿Ya tienes cuenta? Inicia sesión' : '¿Eres nuevo? Regístrate'}
            </button>
          </div>
        </div>
      </div>
    </div>
  );
};

// --- APP PRINCIPAL ---

export default function App() {
  const [user, setUser] = useState(null);
  const [activeTab, setActiveTab] = useState('dashboard');
  const [cases, setCases] = useState([]);
  
  // Modal State
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [newCase, setNewCase] = useState({ client: '', type: '', professor: '', radicado: '' });

  if (!user) {
    return <AuthScreen onLogin={setUser} />;
  }

  const handleLogout = () => {
    if (confirm("¿Cerrar sesión?")) {
      setUser(null);
      setCases([]); 
    }
  };

  const handleAddCase = (e) => {
    e.preventDefault();
    setCases([...cases, { 
      id: Date.now(), 
      ...newCase, 
      status: 'active', 
      date: new Date().toLocaleDateString('es-CO'),
    }]);
    setIsModalOpen(false);
    setNewCase({ client: '', type: '', professor: '', radicado: '' });
  };

  // --- VISTAS ---

  const DashboardView = () => (
    <div className="space-y-8 animate-in fade-in duration-500">
      {/* Encabezado */}
      <div className="border-b border-[#D1D1CB] pb-6 flex flex-col md:flex-row justify-between items-start md:items-end gap-4">
        <div>
          <span className="text-[#003366] text-xs font-bold uppercase tracking-widest mb-1 block">Panel de Control</span>
          <h2 className="text-3xl font-bold text-[#1C1C1E]">Hola, {user.name.split(' ')[0]}</h2>
          <p className="text-[#6e6e73] mt-1">Aquí tienes el resumen de tu práctica jurídica.</p>
        </div>
        <div className="flex gap-3 text-sm font-medium text-[#1C1C1E]">
          <div className="bg-[#EAEAE5] px-4 py-2 rounded flex flex-col items-center">
             <span className="text-[10px] text-[#6e6e73] uppercase tracking-wide">Nivel</span>
             <span className="font-bold text-lg leading-none">{user.semester}º</span>
          </div>
          <div className="bg-[#EAEAE5] px-4 py-2 rounded flex flex-col items-center min-w-[100px]">
             <span className="text-[10px] text-[#6e6e73] uppercase tracking-wide">Área</span>
             <span className="font-bold text-lg leading-none">{user.clinic}</span>
          </div>
        </div>
      </div>

      {/* Indicadores */}
      <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
        <Card className="border-l-4 border-l-[#1C1C1E]">
          <div className="flex justify-between items-start mb-4">
            <h3 className="text-[#6e6e73] text-xs font-bold uppercase tracking-wide">Casos Asignados</h3>
            <FolderOpen className="w-5 h-5 text-[#1C1C1E]" />
          </div>
          <div className="flex items-baseline gap-2">
            <span className="text-4xl font-bold text-[#1C1C1E]">{cases.length}</span>
            <span className="text-sm text-[#6e6e73]">Activos</span>
          </div>
        </Card>

        <Card className="border-l-4 border-l-[#003366]">
          <div className="flex justify-between items-start mb-4">
            <h3 className="text-[#003366] text-xs font-bold uppercase tracking-wide">Próximos Vencimientos</h3>
            <Clock className="w-5 h-5 text-[#003366]" />
          </div>
          <div className="flex items-baseline gap-2">
            <span className="text-4xl font-bold text-[#003366]">0</span>
            <span className="text-sm text-[#003366] font-medium">Esta semana</span>
          </div>
        </Card>

        <Card className="bg-[#1C1C1E] border-none text-white">
          <div className="flex justify-between items-start mb-4">
            <h3 className="text-[#A1A1AA] text-xs font-bold uppercase tracking-wide">Mensajes del Docente</h3>
            <Bell className="w-5 h-5 text-white" />
          </div>
          <p className="text-sm italic leading-relaxed text-[#A1A1AA]">
            No tienes mensajes nuevos de tus tutores.
          </p>
        </Card>
      </div>

      {/* Tabla de Casos */}
      <div>
        <div className="flex items-center justify-between mb-4">
          <h3 className="text-xl font-bold text-[#1C1C1E]">Mis Asignaciones</h3>
        </div>
        
        <div className="bg-white border border-[#D1D1CB] rounded-lg overflow-hidden">
          {cases.length === 0 ? (
            <div className="p-16 text-center flex flex-col items-center justify-center">
              <div className="w-16 h-16 bg-[#F2F2F0] rounded-full flex items-center justify-center mb-4">
                <BookOpen className="w-8 h-8 text-[#A1A1AA]" />
              </div>
              <h3 className="text-lg font-bold text-[#1C1C1E]">Sin casos asignados</h3>
              <p className="text-[#6e6e73] max-w-sm mx-auto mb-6">
                Aún no has registrado ningún caso para este consultorio.
              </p>
              <Button onClick={() => setIsModalOpen(true)}>Registrar Caso</Button>
            </div>
          ) : (
            <table className="w-full text-left text-sm">
              <thead className="bg-[#F2F2F0] text-[#6e6e73] border-b border-[#D1D1CB]">
                <tr>
                  <th className="px-6 py-3 font-bold uppercase text-[10px] tracking-wider">Usuario / Radicado</th>
                  <th className="px-6 py-3 font-bold uppercase text-[10px] tracking-wider">Tipo de Proceso</th>
                  <th className="px-6 py-3 font-bold uppercase text-[10px] tracking-wider">Docente Tutor</th>
                  <th className="px-6 py-3 font-bold uppercase text-[10px] tracking-wider text-right">Estado</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-[#E5E5E0]">
                {cases.map((c) => (
                  <tr key={c.id} className="hover:bg-[#FAFAF9] transition-colors group cursor-pointer">
                    <td className="px-6 py-4">
                      <div className="font-bold text-[#1C1C1E]">{c.client}</div>
                      <div className="text-xs text-[#6e6e73] font-mono mt-0.5">{c.radicado || 'Sin radicar'}</div>
                    </td>
                    <td className="px-6 py-4">
                      <span className="inline-flex items-center gap-2 bg-[#F2F2F0] px-2 py-1 rounded text-xs text-[#1C1C1E] border border-[#E5E5E0]">
                        <FileText className="w-3 h-3" /> {c.type}
                      </span>
                    </td>
                    <td className="px-6 py-4 text-[#52525B]">
                      {c.professor}
                    </td>
                    <td className="px-6 py-4 text-right">
                      <Badge type={c.status}>{c.status === 'urgent' ? 'Urgente' : 'En Trámite'}</Badge>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </div>
      </div>
    </div>
  );

  return (
    <div className={`flex min-h-screen ${THEME.bg} font-sans text-[#1C1C1E]`}>
      
      {/* SIDEBAR */}
      <aside className="hidden md:flex flex-col w-64 bg-[#1C1C1E] text-[#E4E4E7] sticky top-0 h-screen shadow-2xl z-20 border-r border-black">
        <div className="p-6">
          <div className="flex items-center gap-3 mb-10">
            <Scale className="w-6 h-6 text-white" /> 
            <div>
              <h1 className="text-lg font-bold tracking-wide text-white">Consultorio App</h1>
              <p className="text-[10px] text-[#A1A1AA] uppercase tracking-widest">U. Derecho</p>
            </div>
          </div>

          <nav className="space-y-1.5">
            <SidebarItem icon={LayoutDashboard} label="Inicio" active={activeTab === 'dashboard'} onClick={() => setActiveTab('dashboard')} />
            <SidebarItem icon={FolderOpen} label="Mis Casos" active={activeTab === 'cases'} onClick={() => setActiveTab('cases')} />
            <SidebarItem icon={CalendarDays} label="Calendario" active={activeTab === 'calendar'} onClick={() => setActiveTab('calendar')} />
          </nav>
        </div>

        <div className="mt-auto bg-[#18181B] p-6 border-t border-[#27272A]">
          <div className="flex items-center gap-3 mb-4">
             <div className="w-10 h-10 bg-[#27272A] rounded-full flex items-center justify-center font-bold text-white border border-[#3F3F46]">
               {user.name.charAt(0)}
             </div>
             <div className="overflow-hidden">
               <p className="text-sm font-bold text-white truncate">{user.name}</p>
               <p className="text-xs text-[#71717A] truncate">Estudiante</p>
             </div>
          </div>
          <button 
            onClick={handleLogout}
            className="w-full flex items-center gap-2 text-[#A1A1AA] hover:text-white text-xs font-bold uppercase tracking-wider transition-colors"
          >
            <LogOut className="w-4 h-4" /> Cerrar Sesión
          </button>
        </div>
      </aside>

      {/* CONTENIDO PRINCIPAL */}
      <main className="flex-1 p-8 md:p-12 overflow-y-auto w-full">
        {/* Mobile Header */}
        <header className="md:hidden flex justify-between items-center mb-8 border-b border-[#D1D1CB] pb-4">
           <div className="flex items-center gap-2 font-bold text-lg">
             <Scale className="w-6 h-6 text-[#1C1C1E]" /> Consultorio
           </div>
           <button onClick={handleLogout}>
             <LogOut className="w-5 h-5 text-[#6e6e73]" />
           </button>
        </header>

        {activeTab === 'dashboard' && <DashboardView />}
        
        {activeTab === 'cases' && (
          <div className="space-y-6 animate-in slide-in-from-right duration-500">
            <div className="flex justify-between items-end border-b border-[#D1D1CB] pb-4">
              <div>
                <h2 className="text-2xl font-bold text-[#1C1C1E]">Mis Casos</h2>
                <p className="text-sm text-[#6e6e73]">Listado de procesos asignados.</p>
              </div>
              <Button onClick={() => setIsModalOpen(true)}>
                <Plus className="w-4 h-4" /> Nuevo Caso
              </Button>
            </div>
            
            {cases.length === 0 ? (
              <div className="flex flex-col items-center justify-center py-20 border border-dashed border-[#D1D1CB] rounded-lg">
                <FolderOpen className="w-12 h-12 text-[#D1D1CB] mb-4" />
                <h3 className="text-lg font-bold text-[#1C1C1E]">No tienes casos</h3>
                <p className="text-[#6e6e73] mb-4">Aún no has agregado asignaciones.</p>
                <Button onClick={() => setIsModalOpen(true)}>Agregar Caso</Button>
              </div>
            ) : (
              <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                {cases.map((c) => (
                  <div key={c.id} className="bg-white p-6 rounded-lg border border-[#D1D1CB] hover:border-[#003366] transition-colors group shadow-sm">
                     <div className="flex justify-between items-start mb-4">
                       <span className="font-mono text-xs bg-[#F2F2F0] px-2 py-1 rounded text-[#6e6e73]">{c.radicado || 'Sin radicado'}</span>
                       <Badge type={c.status}>{c.status === 'urgent' ? 'Urgente' : 'En Trámite'}</Badge>
                     </div>
                     <h3 className="text-lg font-bold text-[#1C1C1E] mb-1">{c.client}</h3>
                     <p className="text-sm text-[#6e6e73] mb-4 flex items-center gap-2">
                       <FileText className="w-3 h-3" /> {c.type}
                     </p>
                     <div className="border-t border-[#E5E5E0] pt-3 flex justify-between items-center text-xs text-[#6e6e73]">
                        <span>Tutor: {c.professor}</span>
                        <span className="text-[#003366] font-bold">Ver detalles</span>
                     </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        )}
      </main>

      {/* MODAL NUEVO CASO */}
      {isModalOpen && (
        <div className="fixed inset-0 bg-[#1C1C1E]/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
          <div className="bg-[#F9F8F4] w-full max-w-lg shadow-2xl rounded-none border-t-4 border-[#003366] p-8 animate-in zoom-in-95 duration-200 relative">
            <button 
              onClick={() => setIsModalOpen(false)}
              className="absolute top-4 right-4 text-[#6e6e73] hover:text-[#1C1C1E]"
            >
              Cerrar X
            </button>
            
            <h3 className="text-xl font-bold text-[#1C1C1E] mb-6 border-b border-[#D1D1CB] pb-2">
              Registrar Nuevo Caso
            </h3>
            
            <form onSubmit={handleAddCase} className="space-y-4">
              <div>
                <label className="block text-xs font-bold text-[#1C1C1E] uppercase mb-1">Nombre del Usuario (Cliente)</label>
                <input 
                  required
                  className="w-full p-3 bg-white border border-[#D1D1CB] focus:border-[#003366] focus:ring-1 focus:ring-[#003366] outline-none transition-all"
                  placeholder="Ej. Juan Pérez"
                  value={newCase.client}
                  onChange={e => setNewCase({...newCase, client: e.target.value})}
                />
              </div>
              
              <div className="grid grid-cols-2 gap-4">
                <div>
                  <label className="block text-xs font-bold text-[#1C1C1E] uppercase mb-1">Tipo de Proceso</label>
                  <input 
                    required
                    className="w-full p-3 bg-white border border-[#D1D1CB] focus:border-[#003366] focus:ring-1 focus:ring-[#003366] outline-none"
                    placeholder="Ej. Tutela, Alimentos"
                    value={newCase.type}
                    onChange={e => setNewCase({...newCase, type: e.target.value})}
                  />
                </div>
                <div>
                   <label className="block text-xs font-bold text-[#1C1C1E] uppercase mb-1">Radicado (Opcional)</label>
                   <input 
                    className="w-full p-3 bg-white border border-[#D1D1CB] focus:border-[#003366] focus:ring-1 focus:ring-[#003366] outline-none font-mono text-sm"
                    placeholder="2024-XXXXX"
                    value={newCase.radicado}
                    onChange={e => setNewCase({...newCase, radicado: e.target.value})}
                  />
                </div>
              </div>

              <div>
                <label className="block text-xs font-bold text-[#1C1C1E] uppercase mb-1">Docente Tutor</label>
                <input 
                  className="w-full p-3 bg-white border border-[#D1D1CB] focus:border-[#003366] focus:ring-1 focus:ring-[#003366] outline-none"
                  placeholder="Dr(a). Apellido"
                  value={newCase.professor}
                  onChange={e => setNewCase({...newCase, professor: e.target.value})}
                />
              </div>

              <div className="pt-6">
                <Button variant="primary" className="w-full py-3">Guardar Registro</Button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}

const SidebarItem = ({ icon: Icon, label, active, onClick }) => (
  <button 
    onClick={onClick}
    className={`w-full flex items-center gap-3 px-4 py-3 rounded text-sm transition-all duration-200 group ${active ? 'bg-[#27272A] text-white border-l-2 border-[#003366]' : 'text-[#A1A1AA] hover:bg-[#27272A] hover:text-white border-l-2 border-transparent'}`}
  >
    <Icon className={`w-4 h-4 ${active ? 'text-white' : 'text-[#52525B] group-hover:text-white transition-colors'}`} />
    <span className="font-medium tracking-wide">{label}</span>
  </button>
);
